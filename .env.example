# API Keys (Rotate these!)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
META_ACCESS_TOKEN=your_meta_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_insta_id_here

# Database
POSTGRES_USER=marketing_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=hospitality_marketing
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Redis
REDIS_PASSWORD=redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Security
JWT_SECRET_KEY=generate_a_long_random_string_here
